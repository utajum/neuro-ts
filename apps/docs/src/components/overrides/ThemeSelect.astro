---
/**
 * Two-state light/dark toggle, replacing Starlight's stock dropdown.
 *
 * Behaviour notes:
 *  - We only ship two themes (no 'auto'). On first visit the toggle is
 *    initialised from the system preference, but the moment a user
 *    interacts the choice is pinned to localStorage exactly the same way
 *    Starlight's stock ThemeSelect does it.
 *  - Storage key (`starlight-theme`) and `data-theme` attribute on
 *    <html> match the upstream component, so SidebarPersister, the
 *    expressive-code highlighter, and the FOUC inline script in
 *    ThemeProvider all keep working without modification.
 *  - The button reflects the *current* theme via `data-active-theme` so
 *    the icons can fade in/out via CSS - no extra JS for the visuals.
 */
---

<starlight-theme-toggle>
  <button
    type="button"
    class="theme-toggle"
    aria-label="Toggle colour theme"
    title="Toggle colour theme"
  >
    <!-- Sun: visible in dark mode (toggle target = light) -->
    <svg
      class="icon sun"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4.2"></circle>
      <path d="M12 2v2.5"></path>
      <path d="M12 19.5V22"></path>
      <path d="M2 12h2.5"></path>
      <path d="M19.5 12H22"></path>
      <path d="M4.6 4.6l1.8 1.8"></path>
      <path d="M17.6 17.6l1.8 1.8"></path>
      <path d="M19.4 4.6l-1.8 1.8"></path>
      <path d="M6.4 17.6l-1.8 1.8"></path>
    </svg>
    <!-- Moon: visible in light mode (toggle target = dark) -->
    <svg
      class="icon moon"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path>
    </svg>
  </button>
</starlight-theme-toggle>

<style>
  .theme-toggle {
    --tt-size: 32px;
    appearance: none;
    background: var(--neuro-surface-1);
    color: var(--neuro-text-2);
    border: 1px solid var(--sl-color-hairline);
    width: var(--tt-size);
    height: var(--tt-size);
    border-radius: 7px;
    padding: 0;
    cursor: pointer;
    display: inline-grid;
    place-items: center;
    position: relative;
    transition:
      border-color 140ms ease,
      color 140ms ease,
      background 140ms ease;
  }
  .theme-toggle:hover {
    border-color: var(--neuro-accent-strong);
    color: var(--neuro-link-hover);
    background: color-mix(in srgb, var(--neuro-accent-strong) 8%, var(--neuro-surface-1));
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--neuro-accent-strong);
    outline-offset: 2px;
  }
  /* Stack icons; only one is visible per theme. Crossfade for polish. */
  .theme-toggle .icon {
    grid-row: 1;
    grid-column: 1;
    transition:
      opacity 140ms ease,
      transform 180ms ease;
  }
  /* Default state (we'll set data-active-theme from JS). When unset we
   * still want a sensible render so the SSR HTML is valid: show moon
   * in light, sun in dark via :root[data-theme] selectors. */
  :root[data-theme='dark'] .theme-toggle .moon,
  starlight-theme-toggle[data-active-theme='dark'] .moon {
    opacity: 0;
    transform: rotate(-25deg) scale(0.8);
    pointer-events: none;
  }
  :root[data-theme='light'] .theme-toggle .sun,
  starlight-theme-toggle[data-active-theme='light'] .sun {
    opacity: 0;
    transform: rotate(25deg) scale(0.8);
    pointer-events: none;
  }
</style>

<script>
  type Theme = 'dark' | 'light';
  const STORAGE_KEY = 'starlight-theme';

  /**
   * First-visit fallback is hard-coded to `'light'` (the docs default)
   * to match the inline FOUC script in our ThemeProvider override.
   * Returning visitors get their stored choice. We deliberately do not
   * follow `prefers-color-scheme`: light is the brand canvas and the
   * toggle is the explicit opt-in to dark.
   */
  const loadTheme = (): Theme => {
    if (typeof localStorage === 'undefined') return 'light';
    const v = localStorage.getItem(STORAGE_KEY);
    return v === 'dark' || v === 'light' ? v : 'light';
  };

  const storeTheme = (theme: Theme): void => {
    if (typeof localStorage !== 'undefined') localStorage.setItem(STORAGE_KEY, theme);
  };

  /**
   * Apply theme to <html>, persist, and tell every theme-toggle on the
   * page about it (there can be more than one once Starlight renders the
   * mobile sidebar variant).
   */
  function applyTheme(theme: Theme): void {
    document.documentElement.dataset.theme = theme;
    storeTheme(theme);
    document
      .querySelectorAll<HTMLElement>('starlight-theme-toggle')
      .forEach((el) => (el.dataset.activeTheme = theme));
    const provider = (
      window as unknown as {
        StarlightThemeProvider?: { updatePickers: (t: Theme) => void };
      }
    ).StarlightThemeProvider;
    provider?.updatePickers(theme);
  }

  class StarlightThemeToggle extends HTMLElement {
    constructor() {
      super();
      const initial = loadTheme();
      // Apply on construct so the toggle reflects truth even when
      // hydrated mid-page.
      applyTheme(initial);
      this.querySelector('button')?.addEventListener('click', () => {
        const current = (document.documentElement.dataset.theme as Theme) || 'light';
        applyTheme(current === 'dark' ? 'light' : 'dark');
      });
    }
  }
  customElements.define('starlight-theme-toggle', StarlightThemeToggle);
</script>
