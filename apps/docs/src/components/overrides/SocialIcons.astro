---
/**
 * SocialIcons override.
 *
 * Renders (in order): random-method button, support pill, configured
 * social links (npm, github).
 *
 * Desktop: random + social are 32x32 icon squares; support is a pill
 *   with text label. All share the same height (32px) and border style.
 *
 * Mobile (MobileMenuFooter): all five controls collapse to the same
 *   32x32 icon square so they form a uniform row next to ThemeSelect.
 */
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';
import promptsRaw from 'neuro-ts/prompts';

const links = config.social || [];
const SUPPORT_URL = 'https://buymeacoffee.com/utajum';

const prompts = promptsRaw as Record<string, { group: string; methodName: string }>;
const RANDOM_METHOD_URLS: string[] = Object.values(prompts).map(
  (p) =>
    `/methods/${p.group.toLowerCase()}/${p.methodName
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '')}/`,
);
---

<!-- Random method button -->
<button
  type="button"
  class="neuro-random-link sl-flex"
  data-random-methods={JSON.stringify(RANDOM_METHOD_URLS)}
  aria-label="Open a random method"
  title="Random method"
>
  <span class="sr-only">Random method</span>
  <svg
    class="neuro-random-icon"
    aria-hidden="true"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path
      d="M9 4.2A3.2 3.2 0 0 0 5.8 7.4 3 3 0 0 0 4 10v3a3 3 0 0 0 1.7 2.7A3 3 0 0 0 9 19a2.8 2.8 0 0 0 2.8-2.6V5.8A1.6 1.6 0 0 0 10.2 4 1.5 1.5 0 0 0 9 4.2Z"
    ></path>
    <path
      d="M15 4.2A3.2 3.2 0 0 1 18.2 7.4 3 3 0 0 1 20 10v3a3 3 0 0 1-1.7 2.7A3 3 0 0 1 15 19a2.8 2.8 0 0 1-2.8-2.6V5.8A1.6 1.6 0 0 1 13.8 4 1.5 1.5 0 0 1 15 4.2Z"
    ></path>
    <path d="M7 9.2c.7.4 1.4.4 2 0"></path>
    <path d="M15 9.2c.7.4 1.4.4 2 0"></path>
    <path d="M7 13.6c.7.4 1.4.4 2 0"></path>
    <path d="M15 13.6c.7.4 1.4.4 2 0"></path>
    <circle cx="12" cy="11.5" r="1.6" fill="currentColor" stroke="none"></circle>
  </svg>
</button>

<!-- Support pill -->
<a
  class="neuro-support-link sl-flex"
  href={SUPPORT_URL}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Support neuro-ts development"
  title="Support neuro-ts"
>
  <span class="sr-only">Support neuro-ts</span>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path
      d="M12 20.4 L4.6 13.0 a4.4 4.4 0 0 1 6.2 -6.2 L12 7.9 l1.2 -1.1 a4.4 4.4 0 0 1 6.2 6.2 Z"
      fill="currentColor"
      fill-opacity="0.18"></path>
  </svg>
  <span class="label">Support</span>
</a>

<!-- Configured social links (npm, github, …) -->
{
  links.length > 0 && (
    <>
      {links.map(({ label, href, icon }) => (
        <a href={href} rel="me" class="neuro-social-link sl-flex" aria-label={label} title={label}>
          <span class="sr-only">{label}</span>
          <Icon name={icon} />
        </a>
      ))}
    </>
  )
}

<script>
  document.querySelectorAll<HTMLButtonElement>('button.neuro-random-link').forEach((btn) => {
    btn.addEventListener('click', () => {
      const raw = btn.dataset.randomMethods;
      if (!raw) return;
      try {
        const urls = JSON.parse(raw) as string[];
        if (!urls.length) return;
        const next = urls[Math.floor(Math.random() * urls.length)];
        const target =
          urls.length > 1 && next === window.location.pathname
            ? urls[(urls.indexOf(next) + 1) % urls.length]
            : next;
        window.location.assign(target);
      } catch {
        /* ignore */
      }
    });
  });
</script>

<style>
  /* ---- Shared token --------------------------------------------------- */
  :root {
    --ni-size: 32px;
    --ni-radius: 7px;
  }

  /* ---- Unified 32x32 icon-square base --------------------------------- */
  /*
   * All three control types (random, social links, and support on mobile)
   * resolve to the same 32x32 bordered square so they align with ThemeSelect
   * in both the desktop header and the mobile footer.
   */
  .neuro-random-link,
  .neuro-social-link {
    width: var(--ni-size);
    height: var(--ni-size);
    padding: 0;
    margin: 0;
    align-items: center;
    justify-content: center;
    border-radius: var(--ni-radius);
    border: 1px solid var(--sl-color-hairline);
    background: var(--neuro-surface-1, transparent);
    color: var(--sl-color-text-accent);
    cursor: pointer;
    appearance: none;
    text-decoration: none;
    transition:
      border-color 140ms ease,
      background 140ms ease,
      color 140ms ease,
      transform 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .neuro-random-link:hover,
  .neuro-social-link:hover {
    border-color: var(--neuro-accent-strong, var(--sl-color-text-accent));
    background: color-mix(
      in srgb,
      var(--neuro-accent-strong, var(--sl-color-text-accent)) 8%,
      var(--neuro-surface-1, transparent)
    );
    color: var(--neuro-link-hover, var(--sl-color-text-accent));
    transform: translateY(-1px);
  }

  .neuro-random-link:focus-visible,
  .neuro-social-link:focus-visible {
    outline: 2px solid var(--neuro-accent-strong, var(--sl-color-text-accent));
    outline-offset: 2px;
  }

  /* Starlight Icon sets font-size/width/height via --sl-icon-size (1em).
   * Force a fixed size so all social icons are the same regardless of context. */
  .neuro-social-link :global(svg) {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  /* Random icon animations */
  .neuro-random-icon {
    flex-shrink: 0;
    transition:
      transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .neuro-random-link:hover .neuro-random-icon {
    transform: rotate(-6deg) scale(1.08);
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--sl-color-text-accent) 55%, transparent));
  }
  .neuro-random-link:active .neuro-random-icon {
    transform: rotate(6deg) scale(0.94);
  }

  /* ---- Support pill (desktop) ---------------------------------------- */
  .neuro-support-link {
    --support-amber: var(--neuro-accent-strong, #ff8f1a);
    --support-amber-bg: color-mix(in srgb, var(--neuro-accent-strong) 12%, transparent);
    --support-amber-bg-h: color-mix(in srgb, var(--neuro-accent-strong) 22%, transparent);
    --support-amber-bd: color-mix(in srgb, var(--neuro-accent-strong) 50%, transparent);

    height: var(--ni-size);
    align-items: center;
    gap: 0.4rem;
    padding-inline: 0.7rem;
    margin: 0;
    border-radius: var(--ni-radius);
    border: 1px solid var(--support-amber-bd);
    color: var(--support-amber);
    background: var(--support-amber-bg);
    font-family: var(--neuro-font-mono, ui-monospace, monospace);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      transform 160ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 160ms ease,
      background 160ms ease,
      color 160ms ease;
  }

  .neuro-support-link svg {
    flex-shrink: 0;
    transition:
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .neuro-support-link:hover {
    border-color: var(--support-amber);
    background: var(--support-amber-bg-h);
    color: var(--neuro-link-hover, #ffd189);
    transform: translateY(-1px);
  }
  .neuro-support-link:hover svg {
    transform: scale(1.12);
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--support-amber) 60%, transparent));
  }
  .neuro-support-link:active svg {
    transform: scale(0.96);
  }
  .neuro-support-link:focus-visible {
    outline: 2px solid var(--support-amber);
    outline-offset: 2px;
  }

  /* ---- Mobile: collapse support to 32x32 icon, hide text label ------- */
  @media (max-width: 50rem) {
    .neuro-support-link {
      width: var(--ni-size);
      padding: 0;
      justify-content: center;
    }
    .neuro-support-link .label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }
</style>
