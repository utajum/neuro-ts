---
/**
 * Head override for neuro-ts docs.
 *
 * On top of Starlight's stock head (title, description, og:title/url/locale/
 * description/site_name, twitter:card, canonical) this adds:
 *
 *  - og:image + matching twitter:image (per-page OG PNG)
 *  - twitter:title / twitter:description mirrors
 *  - og:type promotion to "website" on the homepage
 *  - Richer, page-typed og:image:alt text
 *  - Page-specific <meta name="keywords">
 *  - <meta name="author"> / robots / googlebot
 *  - BreadcrumbList JSON-LD on every non-home page
 *  - Page-typed structured data:
 *      homepage  -> SoftwareSourceCode + WebSite (with SearchAction)
 *      method    -> TechArticle
 *      group     -> CollectionPage + ItemList
 *      guide (quick-start, install, custom-models) -> HowTo
 *      other guides / concepts -> TechArticle
 *      api/*     -> TechArticle
 *      support   -> WebPage
 *  - <noscript> description fallback
 */
import promptsRaw from 'neuro-ts/prompts';

const route = Astro.locals.starlightRoute;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const siteUrl = (Astro.site ?? new URL('https://neuro-ts.dev/')).toString().replace(/\/$/, '');
const canonical = `${siteUrl}${Astro.url.pathname}`;
const path = Astro.url.pathname;

// ---------------------------------------------------------------------------
// OG image URL
// ---------------------------------------------------------------------------
const ogSlug = isHome ? 'index' : path.replace(/^\/+|\/+$/g, '');
const ogImageUrl = `${siteUrl}/og/${ogSlug}.png`;

// ---------------------------------------------------------------------------
// Prompts data (for method / group structured data)
// ---------------------------------------------------------------------------
interface PromptEntry {
  group: string;
  methodName: string;
  functionId: string;
  kind: 'instance' | 'static' | 'global';
  curated: { comment: string; example: string; prompt: string };
}
const prompts = promptsRaw as Record<string, PromptEntry>;

// ---------------------------------------------------------------------------
// Page-type detection
// ---------------------------------------------------------------------------
const pathSegs = path
  .replace(/^\/+|\/+$/g, '')
  .split('/')
  .filter(Boolean);
// e.g. ["methods","array","map"]

const isMethod = pathSegs[0] === 'methods' && pathSegs.length === 3;
const isGroup = pathSegs[0] === 'methods' && pathSegs.length === 2;
const isMethods = pathSegs[0] === 'methods' && pathSegs.length === 1;
const isGuide = pathSegs[0] === 'guides';
const isConcept = pathSegs[0] === 'concepts';
const isApi = pathSegs[0] === 'api';
const isSupport = path === '/support/';

// ---------------------------------------------------------------------------
// Prompt entry lookup for method pages
// ---------------------------------------------------------------------------
let methodEntry: PromptEntry | undefined;
if (isMethod) {
  const [, grp, mth] = pathSegs;
  const dotted = `neuro.${grp === 'globals' ? '' : grp + '.'}${mth}`;
  const key = Object.keys(prompts).find((k) => k.toLowerCase() === dotted.toLowerCase());
  methodEntry = key ? prompts[key] : undefined;
}

const dotted = methodEntry
  ? `neuro.${pathSegs[1] === 'globals' ? '' : pathSegs[1] + '.'}${pathSegs[2]}`
  : '';
const functionId = methodEntry?.functionId ?? '';

// ---------------------------------------------------------------------------
// Group display names
// ---------------------------------------------------------------------------
const GROUP_DISPLAY: Record<string, string> = {
  array: 'Array',
  arraybuffer: 'ArrayBuffer',
  atomics: 'Atomics',
  bigint: 'BigInt',
  bigint64array: 'BigInt64Array',
  biguint64array: 'BigUint64Array',
  dataview: 'DataView',
  date: 'Date',
  float32array: 'Float32Array',
  float64array: 'Float64Array',
  globals: 'Globals',
  int8array: 'Int8Array',
  int16array: 'Int16Array',
  int32array: 'Int32Array',
  intl: 'Intl',
  json: 'JSON',
  map: 'Map',
  math: 'Math',
  number: 'Number',
  object: 'Object',
  promise: 'Promise',
  proxy: 'Proxy',
  reflect: 'Reflect',
  regexp: 'RegExp',
  set: 'Set',
  string: 'String',
  symbol: 'Symbol',
  typedarray: 'TypedArray',
  uint8array: 'Uint8Array',
  uint8clampedarray: 'Uint8ClampedArray',
  uint16array: 'Uint16Array',
  uint32array: 'Uint32Array',
  weakmap: 'WeakMap',
  weakset: 'WeakSet',
};
const groupDisplay = isGroup || isMethod ? (GROUP_DISPLAY[pathSegs[1]] ?? pathSegs[1]) : '';

// ---------------------------------------------------------------------------
// Starlight head filtering (strip og:type on home, replace below)
// ---------------------------------------------------------------------------
const headTags = route.head.filter((t) => {
  if (!isHome) return true;
  if (t.tag !== 'meta') return true;
  const attrs = (t.attrs ?? {}) as { property?: string };
  return attrs.property !== 'og:type';
});

// ---------------------------------------------------------------------------
// Title / description extraction
// ---------------------------------------------------------------------------
const titleEl = route.head.find((t) => t.tag === 'title');
const descEl = route.head.find(
  (t) => t.tag === 'meta' && ((t.attrs ?? {}) as { name?: string }).name === 'description',
);
const titleText = ((titleEl?.content ?? '') as string) || route.entry.data.title;
const descText =
  ((descEl?.attrs ?? {}) as { content?: string }).content ?? route.entry.data.description ?? '';

// ---------------------------------------------------------------------------
// Richer og:image:alt (E)
// ---------------------------------------------------------------------------
let ogAlt: string;
if (isHome) {
  ogAlt =
    'neuro-ts: AI-augmented JavaScript built-ins for TypeScript with optional GPT and OpenAI prompts';
} else if (isMethod && methodEntry) {
  ogAlt = `Code example: how to call ${dotted}, an AI-augmented JavaScript wrapper around ${functionId}`;
} else if (isGroup) {
  ogAlt = `Catalog: AI-augmented JavaScript wrappers for ${groupDisplay}`;
} else if (isGuide) {
  ogAlt = `Guide: ${route.entry.data.title} - neuro-ts AI-augmented JavaScript and TypeScript library`;
} else if (isConcept) {
  ogAlt = `Concept: ${route.entry.data.title} - how neuro-ts works`;
} else if (isSupport) {
  ogAlt = 'Support the neuro-ts project';
} else {
  ogAlt = `${route.entry.data.title} - neuro-ts`;
}

// ---------------------------------------------------------------------------
// Page-specific keywords (G)
// ---------------------------------------------------------------------------
let keywords: string;
if (isHome) {
  keywords =
    'neuro-ts, AI-augmented JavaScript, TypeScript, OpenAI, GPT, LLM, AI SDK, built-ins, array.map, math.random, json.parse, prompt engineering, native fallback';
} else if (isMethod && methodEntry) {
  keywords = `${methodEntry.group}, ${methodEntry.methodName}, ${functionId}, JavaScript, TypeScript, AI, GPT, OpenAI, neuro-ts, AI-augmented JavaScript, native fallback, prompt`;
} else if (isGroup) {
  keywords = `${groupDisplay}, ${pathSegs[1]} methods, JavaScript ${groupDisplay}, TypeScript ${groupDisplay}, AI-augmented ${groupDisplay}, neuro-ts`;
} else if (isMethods) {
  keywords =
    'neuro-ts methods, AI-augmented JavaScript built-ins, TypeScript, OpenAI, GPT, all methods';
} else if (path === '/guides/quick-start/') {
  keywords =
    'neuro-ts quick start, install, getting started, OpenAI, TypeScript, JavaScript, AI built-ins, tutorial';
} else if (path === '/guides/install/') {
  keywords = 'neuro-ts install, npm, pnpm, yarn, bun, CDN, TypeScript, JavaScript, AI library';
} else if (path === '/guides/browser-safety/') {
  keywords =
    'neuro-ts browser, browser safety, API key, proxy, tokenProvider, OpenAI, JavaScript, TypeScript';
} else if (path === '/guides/custom-models/') {
  keywords =
    'neuro-ts custom models, OpenAI-compatible, gpt-4o, model override, TypeScript, JavaScript';
} else if (path === '/guides/proxy-contract/') {
  keywords =
    'neuro-ts proxy, proxy contract, wire format, JSON, TypeScript, JavaScript, OpenAI proxy';
} else if (path === '/guides/native-fallback/') {
  keywords =
    'native fallback, no LLM, no prompt, TypeScript, JavaScript, neuro-ts, built-in passthrough';
} else if (path === '/concepts/naming/') {
  keywords = 'neuro-ts naming, namespace, TypeScript signatures, JavaScript built-ins, API design';
} else if (path === '/concepts/prompt-engineering/') {
  keywords =
    'neuro-ts prompts, system prompt, GPT, OpenAI, prompt engineering, deterministic, TypeScript';
} else if (path === '/concepts/catalog/') {
  keywords = 'neuro-ts catalog, all methods, built-ins, JavaScript, TypeScript, AI wrappers';
} else if (isApi) {
  keywords = `neuro-ts API, ${route.entry.data.title}, TypeScript, JavaScript, client, configuration`;
} else if (isSupport) {
  keywords = 'support neuro-ts, sponsor, GitHub, open source, AI JavaScript library, TypeScript';
} else {
  keywords = 'neuro-ts, AI-augmented JavaScript, TypeScript, OpenAI, GPT, built-ins';
}

// ---------------------------------------------------------------------------
// Breadcrumbs (C)
// ---------------------------------------------------------------------------
interface Crumb {
  name: string;
  url: string;
}
const breadcrumbs: Crumb[] = [];
if (!isHome) {
  breadcrumbs.push({ name: 'Home', url: siteUrl + '/' });
  if (pathSegs[0] === 'methods') {
    breadcrumbs.push({ name: 'Methods', url: `${siteUrl}/methods/` });
    if (pathSegs.length >= 2) {
      breadcrumbs.push({
        name: groupDisplay || pathSegs[1],
        url: `${siteUrl}/methods/${pathSegs[1]}/`,
      });
    }
    if (pathSegs.length >= 3) {
      breadcrumbs.push({ name: methodEntry?.methodName ?? pathSegs[2], url: canonical });
    }
  } else if (pathSegs[0] === 'guides') {
    breadcrumbs.push({ name: 'Guides', url: `${siteUrl}/guides/` });
    breadcrumbs.push({ name: route.entry.data.title, url: canonical });
  } else if (pathSegs[0] === 'concepts') {
    breadcrumbs.push({ name: 'Concepts', url: `${siteUrl}/concepts/` });
    breadcrumbs.push({ name: route.entry.data.title, url: canonical });
  } else if (pathSegs[0] === 'api') {
    breadcrumbs.push({ name: 'API Reference', url: `${siteUrl}/api/` });
    breadcrumbs.push({ name: route.entry.data.title, url: canonical });
  } else {
    breadcrumbs.push({ name: route.entry.data.title, url: canonical });
  }
}

const breadcrumbJsonLd =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((crumb, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: crumb.name,
          item: crumb.url,
        })),
      }
    : null;

// ---------------------------------------------------------------------------
// Shared author / publisher objects
// ---------------------------------------------------------------------------
const author = {
  '@type': 'Person',
  name: 'Vladimir Tasik',
  url: 'https://github.com/utajum',
};
const publisher = {
  '@type': 'Organization',
  name: 'neuro-ts',
  url: siteUrl,
  logo: { '@type': 'ImageObject', url: `${siteUrl}/logo-light.svg` },
};
const buildDate = new Date().toISOString();

// ---------------------------------------------------------------------------
// Page-typed JSON-LD (B)
// ---------------------------------------------------------------------------
let pageJsonLd: object | null = null;

if (isHome) {
  // SoftwareSourceCode + WebSite with SearchAction emitted separately below
  pageJsonLd = null; // handled in the template section
} else if (isMethod && methodEntry) {
  pageJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: dotted,
    description: descText,
    image: ogImageUrl,
    url: canonical,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    author,
    publisher,
    datePublished: buildDate,
    dateModified: buildDate,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', url: siteUrl },
    articleSection: 'API Reference',
    keywords: keywords,
    programmingLanguage: ['TypeScript', 'JavaScript'],
    about: {
      '@type': 'SoftwareSourceCode',
      name: 'neuro-ts',
      codeRepository: 'https://github.com/utajum/neuro-ts',
    },
  };
} else if (isGroup) {
  // Collect methods in this group
  const grp = pathSegs[1];
  const groupMethods = Object.entries(prompts)
    .filter(([, e]) => e.group === grp || e.group.toLowerCase() === grp)
    .map(([key, e], idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      url: `${siteUrl}/methods/${grp}/${e.methodName.toLowerCase()}/`,
      name: key,
    }));
  pageJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    headline: route.entry.data.title,
    description: descText,
    image: ogImageUrl,
    url: canonical,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    author,
    publisher,
    datePublished: buildDate,
    dateModified: buildDate,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', url: siteUrl },
    mainEntity: {
      '@type': 'ItemList',
      name: `${groupDisplay} wrappers`,
      numberOfItems: groupMethods.length,
      itemListElement: groupMethods,
    },
  };
} else if (isMethods) {
  pageJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    headline: 'neuro-ts method reference',
    description: descText,
    image: ogImageUrl,
    url: canonical,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    author,
    publisher,
    datePublished: buildDate,
    dateModified: buildDate,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', url: siteUrl },
  };
} else if (path === '/guides/quick-start/') {
  pageJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'Quick start with neuro-ts',
    description: descText,
    image: ogImageUrl,
    url: canonical,
    inLanguage: 'en',
    author,
    publisher,
    datePublished: buildDate,
    dateModified: buildDate,
    totalTime: 'PT5M',
    estimatedCost: { '@type': 'MonetaryAmount', currency: 'USD', value: '0' },
    tool: [{ '@type': 'HowToTool', name: 'Node.js 18.18+' }],
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: 'Install',
        url: `${canonical}#1-install`,
        text: 'Install neuro-ts with npm, pnpm, yarn or bun.',
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Configure the client',
        url: `${canonical}#2-configure-the-client-nodejs`,
        text: 'Call configureClient with your OpenAI API key.',
      },
      {
        '@type': 'HowToStep',
        position: 3,
        name: 'Call a wrapped built-in',
        url: `${canonical}#3-call-something`,
        text: 'Call any neuro.* method with an optional prompt field.',
      },
      {
        '@type': 'HowToStep',
        position: 4,
        name: 'Inspect what is sent',
        url: `${canonical}#4-inspect-what-is-sent`,
        text: 'Use the debug logger to see the exact system prompt sent to the LLM.',
      },
    ],
  };
} else if (path === '/guides/install/') {
  pageJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'Install neuro-ts',
    description: descText,
    image: ogImageUrl,
    url: canonical,
    inLanguage: 'en',
    author,
    publisher,
    datePublished: buildDate,
    dateModified: buildDate,
    totalTime: 'PT2M',
    estimatedCost: { '@type': 'MonetaryAmount', currency: 'USD', value: '0' },
    tool: [
      { '@type': 'HowToTool', name: 'Node.js 18.18+' },
      { '@type': 'HowToTool', name: 'npm / pnpm / yarn / bun' },
    ],
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: 'Install the package',
        url: `${canonical}`,
        text: 'Run npm install neuro-ts (or pnpm add / yarn add / bun add).',
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Check peer requirements',
        url: `${canonical}#peer-requirements`,
        text: 'Ensure Node.js 18.18 or later.',
      },
      {
        '@type': 'HowToStep',
        position: 3,
        name: 'Verify your install',
        url: `${canonical}#verify-your-install`,
        text: 'Import configureClient and call a wrapper to confirm everything resolves.',
      },
    ],
  };
} else if (path === '/guides/custom-models/') {
  pageJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'Configure custom models with neuro-ts',
    description: descText,
    image: ogImageUrl,
    url: canonical,
    inLanguage: 'en',
    author,
    publisher,
    datePublished: buildDate,
    dateModified: buildDate,
    totalTime: 'PT3M',
    estimatedCost: { '@type': 'MonetaryAmount', currency: 'USD', value: '0' },
    tool: [{ '@type': 'HowToTool', name: 'neuro-ts' }],
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: 'Change the default model',
        url: `${canonical}#change-the-default-model`,
        text: 'Pass a model name to configureClient to change the global default.',
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Per-call override',
        url: `${canonical}#per-call-override-low-level`,
        text: 'Use the low-level executeFunction API to override the model for a single call.',
      },
      {
        '@type': 'HowToStep',
        position: 3,
        name: 'Point at any OpenAI-compatible endpoint',
        url: `${canonical}#openai-compatible-endpoints`,
        text: 'Set baseURL in configureClient to use Ollama, Azure OpenAI, or any compatible provider.',
      },
    ],
  };
} else if (isGuide || isConcept) {
  pageJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: route.entry.data.title,
    description: descText,
    image: ogImageUrl,
    url: canonical,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    author,
    publisher,
    datePublished: buildDate,
    dateModified: buildDate,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', url: siteUrl },
    articleSection: isConcept ? 'Concepts' : 'Guides',
    keywords: keywords,
  };
} else if (isApi) {
  pageJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: route.entry.data.title,
    description: descText,
    image: ogImageUrl,
    url: canonical,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    author,
    publisher,
    datePublished: buildDate,
    dateModified: buildDate,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', url: siteUrl },
    articleSection: 'API Reference',
    programmingLanguage: ['TypeScript', 'JavaScript'],
  };
} else if (isSupport) {
  pageJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: route.entry.data.title,
    description: descText,
    url: canonical,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', url: siteUrl },
    author,
    datePublished: buildDate,
    dateModified: buildDate,
  };
}

// ---------------------------------------------------------------------------
// Homepage structured data
// ---------------------------------------------------------------------------
const homeSoftwareJsonLd = isHome
  ? {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'neuro-ts',
      description:
        'AI-augmented JavaScript built-ins. Wrap Array.map, Math.random, JSON.parse, and 600+ standard library methods with optional GPT prompts. TypeScript-first.',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Cross-platform',
      programmingLanguage: ['JavaScript', 'TypeScript'],
      codeRepository: 'https://github.com/utajum/neuro-ts',
      license: 'https://opensource.org/licenses/MIT',
      url: siteUrl,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      author,
      publisher,
      keywords:
        'javascript, AI, OpenAI, LLM, GPT, TypeScript, prompt engineering, built-ins, AI SDK',
    }
  : null;

const homeWebSiteJsonLd = isHome
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'neuro-ts',
      url: siteUrl,
      potentialAction: {
        '@type': 'SearchAction',
        target: `${siteUrl}/?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    }
  : null;
---

{
  /* Upstream Starlight tags (title, description, og:title/type/url/locale/description/site_name,
     twitter:card, canonical link, etc). On the homepage og:type is filtered above. */
  headTags.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)
}

{isHome && <meta property="og:type" content="website" />}

{/* Open Graph image */}
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:secure_url" content={ogImageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />

{/* Twitter card mirrors */}
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogAlt} />
<meta name="twitter:title" content={titleText} />
<meta name="twitter:description" content={descText} />

{/* SEO */}
<meta name="author" content="Vladimir Tasik" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
<meta name="googlebot" content="index, follow" />
<meta name="keywords" content={keywords} />

{/* Breadcrumbs */}
{
  breadcrumbJsonLd && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  )
}

{/* Page-typed structured data */}
{
  pageJsonLd && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(pageJsonLd)} />
  )
}

{/* Homepage structured data */}
{
  homeSoftwareJsonLd && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(homeSoftwareJsonLd)} />
  )
}
{
  homeWebSiteJsonLd && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(homeWebSiteJsonLd)} />
  )
}

{/* noscript fallback */}
<noscript><meta name="description" content={descText} /></noscript>

{
  /* SearchAction ?q= handler: reads the query param Google appends when the
    sitelinks searchbox is clicked and hands it off to Pagefind.
    Logic lives in src/scripts/search-jump.ts; Astro/Vite compiles and
    defers it automatically as an ES module. */
}
{isHome && <script>import '../../scripts/search-jump.ts';</script>}

{/* PostHog analytics */}
<script is:inline>
