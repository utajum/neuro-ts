---
/**
 * Override of Starlight's stock `Head` component. Starlight ships
 * `og:title`, `og:url`, `og:description`, `og:type=article`,
 * `og:site_name`, `og:locale`, `twitter:card=summary_large_image` and a
 * `<title>`/`<meta description>` for free, but does not add an
 * `og:image` (which makes the `summary_large_image` Twitter card
 * technically invalid) and gives every page `og:type=article` even on
 * the homepage.
 *
 * This override:
 *
 *  1. Renders Starlight's existing `head` array first (preserves all
 *     upstream meta).
 *  2. Adds `og:image` + matching `twitter:image` pointing at the
 *     per-page card emitted by `src/pages/og/[...slug].png.ts`.
 *  3. Adds `twitter:title`/`twitter:description`/`twitter:image:alt`
 *     mirroring the OG values, so Twitter validators stop warning.
 *  4. Promotes `og:type` to `website` on the homepage.
 *  5. Adds `<meta name="author" / robots / keywords>` and a JSON-LD
 *     `SoftwareSourceCode` block on the homepage for richer Google
 *     snippets.
 */
const route = Astro.locals.starlightRoute;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const siteUrl = (Astro.site ?? new URL('https://neuro-js.dev/')).toString().replace(/\/$/, '');

// Derive the OG image slug straight from the URL pathname so it matches
// the route generated by `src/pages/og/[...slug].ts` regardless of how
// Starlight surfaces the route id internally.
const ogSlug = isHome ? 'index' : Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const ogImageUrl = `${siteUrl}/og/${ogSlug}.png`;

// Strip Starlight's auto-emitted `og:type=article` on the homepage so we
// can replace it with `og:type=website` further down. Everything else is
// rendered untouched.
const headTags = route.head.filter((t) => {
  if (!isHome) return true;
  if (t.tag !== 'meta') return true;
  const attrs = (t.attrs ?? {}) as { property?: string };
  return attrs.property !== 'og:type';
});

const titleTagAttrs = (route.head.find((t) => t.tag === 'title')?.content ?? '') as string;
const descTagAttrs = (route.head.find(
  (t) => t.tag === 'meta' && ((t.attrs ?? {}) as { name?: string }).name === 'description',
)?.attrs ?? {}) as { content?: string };
const titleText = titleTagAttrs || route.entry.data.title;
const descText = descTagAttrs.content ?? route.entry.data.description ?? '';
const ogAlt = `${route.entry.data.title} - neuro-js`;

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'neuro-js',
  description:
    'AI-augmented JavaScript built-ins. Wrap Array.map, Math.random, JSON.parse, and 600+ standard library methods with optional GPT prompts. TypeScript-first.',
  codeRepository: 'https://github.com/utajum/neuro-js',
  programmingLanguage: ['JavaScript', 'TypeScript'],
  license: 'https://opensource.org/licenses/MIT',
  url: siteUrl,
  author: {
    '@type': 'Person',
    name: 'Vladimir Tasik',
    url: 'https://github.com/utajum',
  },
  keywords: 'javascript, ai, openai, llm, gpt, typescript, prompt engineering, builtins, ai sdk',
};
---

{
  /* Render every tag Starlight already computed (title, description,
     og:title, og:type, og:url, og:locale, og:description, og:site_name,
     twitter:card, canonical link, etc). On the homepage `og:type` was
     filtered above so we can replace it with `website`. */
  headTags.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)
}

{isHome && <meta property="og:type" content="website" />}

{/* Open Graph image. Same URL fed to Twitter, LinkedIn, Slack, Discord, etc. */}
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:secure_url" content={ogImageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />

{/* Explicit Twitter mirrors so the summary_large_image card validates. */}
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogAlt} />
<meta name="twitter:title" content={titleText} />
<meta name="twitter:description" content={descText} />

{/* SEO */}
<meta name="author" content="Vladimir Tasik" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
<meta name="googlebot" content="index, follow" />
<meta
  name="keywords"
  content="javascript, typescript, openai, llm, ai, gpt, prompt-engineering, neuro-js, ai sdk, ai library, openai sdk, gpt sdk, ai javascript library, llm wrapper, builtins, array.map, math.random, json.parse"
/>

{isHome && <script is:inline type="application/ld+json" set:html={JSON.stringify(homeJsonLd)} />}
