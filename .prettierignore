# Mirror of .gitignore plus a few extras Prettier should never touch.
# Keep this file in sync with .gitignore for the rules that apply to
# both - both files exclude generated artifacts, vendored sources, and
# build output.

# Dependencies / package manager
node_modules
.pnpm-store
pnpm-lock.yaml

# Build output
dist
.astro
.turbo
.scripts-build
**/*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# Coverage
coverage
.nyc_output

# Pack output
*.tgz

# Logs
*.log

# Editor
.vscode
.idea
.agents
.claude
.windsurf
.opencode
skills*

# OS
.DS_Store
Thumbs.db

# Generated docs API (typedoc-driven; regenerated each build)
apps/docs/src/content/docs/api

# Generated method-catalog MDX (regenerated by generate-api-docs.ts)
apps/docs/src/content/docs/methods
apps/docs/src/api-sidebar.json

# Generated wrapper sources
packages/neuro-js/src/generated

# OG image cache
apps/docs/.astro-og-canvas

# Pagefind / search index
apps/docs/dist/_pagefind
apps/docs/dist

# Vendored libraries (we intentionally preserve upstream formatting)
packages/vendor

# GitHub Actions workflows: Prettier's YAML parser chokes on the
# `${{ env.X }}` flow-map style used in setup actions (it sees a
# missing comma). The actions runner is the only consumer.
.github/workflows

# Internal product/design docs (kept local)
PRODUCT.md
DESIGN.md
.planning

# Binary-ish assets prettier should not touch
public/**/*.svg
apps/docs/public/**/*.svg
apps/docs/public/fonts
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.webp
**/*.ttf
**/*.woff
**/*.woff2
